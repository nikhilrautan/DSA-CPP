#include <iostream>
#include <vector>
using namespace std;

// Q2. Find Minimum in Rotated Sorted Array.
int findMin(vector<int> &nums)
{
    int start = 0, end = nums.size() - 1, ans = nums[0], mid;
    while (start <= end)
    {
        mid = start + (end - start) / 2;
        if (nums[mid] >= nums[0])
        {
            start = mid + 1;
        }
        else
        {
            ans = nums[mid];
            end = mid - 1;
        }
    }

    return ans;
}

int main()
{
    vector<int> nums = {4, 5, 6, 7, 0, 1, 2};

    int minimum = findMin(nums);

    cout << "Minimum element is: " << minimum << endl;

    return 0;
}
